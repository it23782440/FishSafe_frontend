# ============================================================
#  FishSafe frontend environment variables
#  Copy to ".env.local" for local dev; set in Vercel for prod.
# ============================================================

# Base URL of your backend API (NO trailing slash).
# NEXT_PUBLIC_ is required so the value is available in the browser.
# Local:   http://localhost:5000
# Prod:    https://your-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# The device this dashboard shows by default.
NEXT_PUBLIC_DEVICE_ID=FISHSAFE-001

# Dashboard auto-refresh interval in milliseconds (polling).
NEXT_PUBLIC_POLL_MS=10000
